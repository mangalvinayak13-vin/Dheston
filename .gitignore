# raw downloads and caches are rebuilt by dh2.fetch_nse / dh2.fetch_nse_old / load_all (about 0.5 GB)
data/nse_index/
data/cache/
# large result pickles (walks, forecast variants, trade lists) are rebuilt by run_walk.py / hybrids.py / trade_test.py
data/results/*.pkl
# keep the small summaries: data/results/*.json
logs/
# fit caches of the experiments, rebuilt by the exp_*.py scripts; resume caches of the VIX download
results/_cache/
results/pinn_calib/_cache/
# PINN checkpoints: only the two shipped models are kept; the seed/ablation checkpoints are rebuilt by dh2/pinn/experiments.py
results/pinn/checkpoints/*.pt
!results/pinn/checkpoints/final.pt
!results/pinn/checkpoints/final_greeks.pt
data/vix/_nse_*
__pycache__/
.pytest_cache/
*.pyc
